# ============================================================
# RandomPick — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=RandomPick

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Meta / Instagram API
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/oauth/callback

# Token Encryption — AES-256-GCM
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your-64-hex-character-key-here

# Optional external provider (leave empty to disable)
OPTIONAL_INSTAGRAM_PROVIDER_URL=
OPTIONAL_INSTAGRAM_PROVIDER_API_KEY=

# Postgres (Supabase connection string, or local DATABASE_URL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=true

# Demo mode is set automatically by `npm run demo`.
# Do not enable NEXT_PUBLIC_DEMO_MODE in production.
NEXT_PUBLIC_DEMO_MODE=false
# DEMO_SESSION_SECRET is generated by the demo script; leave empty here.
